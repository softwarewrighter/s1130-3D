## Ibm1130Colors.xtl -- Color palette and materials for the IBM 1130
## computing system. Derived from IBM archival photographs, service
## manuals, and preserved museum hardware (Computer History Museum,
## VCF, and University archives).
##
## Colors are linear RGB (0.0 to 1.0).
## Import: "co:" u_se< "Ibm1130Colors"

### Cabinet and Structural Finishes

## Classic IBM corporate royal blue (right pedestal front service door)
l:ibmBlue := 0.04 0.20 0.54

## Recessed ventilation grille backing behind blue door louvers
l:ibmBlueGrille := 0.02 0.08 0.22

## Textured dark charcoal/near-black enamelled steel (pedestal sides,
## kickplate, modesty panel, printer casing, display posts)
l:charcoalCabinet := 0.08 0.09 0.10

## Off-white / almond cream laminate desktop surface
l:desktopCream := 0.82 0.80 0.75

## Dark vinyl / extruded aluminum edge trim around desktop perimeter
l:deskEdgeTrim := 0.12 0.12 0.14

## Light warm gray / off-white sheet metal for elevated display console
l:panelOffWhite := 0.76 0.76 0.74

## Matte dark charcoal for display faceplate and keyboard well bezel
l:faceplateCharcoal := 0.07 0.08 0.09

### Register Nibble Bands (Display Panel)

## Light gray nibble band for alternating 4-bit register segments
l:nibbleLight := 0.32 0.34 0.37

## Dark gray nibble band for alternating 4-bit register segments
l:nibbleDark := 0.15 0.16 0.18

### Indicator Lamps and Lenses

## Unlit incandescent lamp aperture / jewel
l:lampOff := 0.16 0.15 0.14

## Lit register incandescent lamp (warm glowing amber)
l:lampAmber := 1.0 0.65 0.06

## Lit white indicator lamp
l:lampWhite := 1.0 0.96 0.86

## Red warning / alarm / parity lamp
l:lampRed := 0.95 0.08 0.05

## Green ready / run lamp
l:lampGreen := 0.08 0.92 0.16

### Emergency Power Off (EPO) and Rotary Switch

## Bright red EPO pull knob
l:epoRed := 0.88 0.10 0.08

## Recessed black bezel cup for EPO switch
l:epoBezel := 0.04 0.04 0.04

## Black fluted rotary mode switch knob
l:rotaryBlack := 0.06 0.06 0.07

## White tick marks and dial lettering
l:tickWhite := 0.92 0.92 0.92

### Keyboard Keycaps and Console Switches

## IBM classic slate blue keycaps (alphanumeric keys)
l:keycapBlue := 0.20 0.38 0.62

## Light gray / off-white keycaps (numbers, punctuation)
l:keycapGray := 0.72 0.72 0.70

## Dark charcoal keycaps (space bar, function keys: NUM, REST KB, EOF)
l:keycapDark := 0.10 0.11 0.12

## Backlit pushbuttons (Control switch panel beside keyboard)
l:buttonRed := 0.86 0.10 0.08
l:buttonBlue := 0.10 0.32 0.75
l:buttonGreen := 0.10 0.72 0.18
l:buttonWhite := 0.88 0.88 0.86
l:buttonAmber := 0.95 0.60 0.08

### Metals, Hardware and Translucent Materials

## Chrome / polished silver (toggle levers, platen knobs, standoffs)
l:chromeSilver := 0.84 0.85 0.88

## Brushed aluminum badge surface
l:brushedAluminum := 0.78 0.79 0.80

## Black rubber platen roller
l:platenRubber := 0.05 0.05 0.06

## Smoked transparent acrylic (printer dust cover, disk drive lid)
l:smokedAcrylic := 0.10 0.12 0.15

## Floor ground plane
l:floorGray := 0.88 0.88 0.86
